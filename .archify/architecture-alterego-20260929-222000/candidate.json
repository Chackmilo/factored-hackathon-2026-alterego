  "cards": [
    {
      "dot": "cyan",
      "title": "Identity & Security (SEC-01..SEC-05)",
      "items": [
        "ES256 session tokens verified against Supabase JWKS with no shared secret in backend",
        "customer_id extracted exclusively from verified session token (app_metadata)",
        "LATAM document PII masking and XML merchant data boundaries prevent prompt injection"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic Policy & State Machine",
      "items": [
        "Understand -> Decide -> Act -> Verify -> Escalate 5-stage orchestration",
        "DisputePolicyEngine v2.3 checks 10 policy clauses in strict, auditable order",
        "Only two mutations allowed: open dispute case and customer-confirmed temporary card lock"
      ]
    },
    {
      "dot": "violet",
      "title": "ML Risk & Adaptive Thresholding",
      "items": [
        "LightGBM trained on 590k IEEE-CIS transactions (holdout ROC AUC 0.817)",
        "19 deployable features homologated via FeatureContract v1.1",
        "Percentile 98 threshold (0.0669) on Web/App window safely detonates POL-ESC-ML-RISK"
      ]
    },
    {
      "dot": "amber",
      "title": "Postgres Serving & Lakehouse",
      "items": [
        "Supabase Postgres bank schema hosts read-only serving copy of gold tables",
        "Postgres ops schema provides append-only audit trail and turn state",
        "BankingToolGateway executes Act-and-Verify reads back from system of record"
      ]
    }
