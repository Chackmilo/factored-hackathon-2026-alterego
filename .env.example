# Environment Configuration
APP_ENV=development                    # development or test turn on the local issuer and the starter routes; missing, blank or any other value means production
APP_PORT=8000
DEBUG=True

# LLM Providers (Optional for local testing / mock mode available)
LLM_PROVIDER=mock  # Options: mock, openai, anthropic, gemini, groq
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Thresholds for Hybrid Decision Engine
FRAUD_RISK_HIGH_THRESHOLD=0.85     # Above this -> Deterministic / Immediate Freeze
FRAUD_RISK_MEDIUM_THRESHOLD=0.50   # Between 0.50 and 0.85 -> Agentic verification or HITL
HITL_CONFIDENCE_THRESHOLD=0.70     # Below this -> Escalate to Human-in-the-Loop
MAX_AUTONOMOUS_TRANSACTION_LIMIT=500.0  # Max USD amount agent can autonomously refund

# Dispute stack (src/api/dispute_routes.py). Paths are relative to the repo root.
LAKEHOUSE_PATH=data/lakehouse.duckdb   # read by the tool gateway (bank facts); build it with `uv run python -m src.data.ingestion`
OPS_DB_PATH=data/ops.duckdb            # operational store (conversations, cases, locks, handoffs, audit); created on first use
DATABASE_URL=                          # postgresql://... (Supabase pooler as app_gateway, or a local Postgres). When set, bank and ops both come from Postgres: apply supabase/migrations and run src.data.publish_serving first
SUPABASE_URL=                          # https://<project-ref>.supabase.co; the API verifies ES256 tokens against its JWKS and issuer
SUPABASE_SECRET_KEY=                   # sb_secret_...: only for `python -m src.auth.seed_personas` on your machine; never in Vercel, the front or the repo
LOCAL_ISSUER_ENABLED=true              # ES256 test issuer for personas; ignored (and refused if true) when APP_ENV=production
